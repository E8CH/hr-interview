# Service 03 — Response Collector 환경변수
SERVICE_PORT=8003

# --- PoC 모드 (Docker 불필요) ---
DATABASE_URL=sqlite:///./resp_db.sqlite
REDIS_URL=fakeredis://
USE_MOCK=true
STORAGE_DIR=./storage

# --- 통합 모드 (docker-compose) ---
# DATABASE_URL=postgresql://hruser:hrpass@postgres:5432/resp_db
# REDIS_URL=redis://redis:6379/0
# USE_MOCK=false
# NOTIFICATION_SERVICE_URL=http://notification-hub:8006

LOG_LEVEL=INFO

# 폼 링크 생성용 베이스 URL (초대 메일에 들어감)
FORM_BASE_URL=http://localhost:8003

# 리마인더 스케줄러
ENABLE_SCHEDULER=true
REMINDER_POLL_MINUTES=30
