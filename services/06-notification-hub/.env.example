# --- Service 06 Notification Hub 환경변수 ---
SERVICE_PORT=8006

# 프로덕션(Docker) 설정
DATABASE_URL=postgresql://hruser:hrpass@postgres:5432/notif_db
REDIS_URL=redis://redis:6379/0

# PoC(로컬, Docker 불필요) 설정 — .env 에서는 아래 값을 사용
# DATABASE_URL=sqlite:///./notif_db.sqlite
# REDIS_URL=fakeredis://

# true 면 실제 발송 없이 ./storage/outbox 에 산출물만 남긴다
USE_MOCK=true
STORAGE_DIR=./storage
LOG_LEVEL=INFO

# 트래킹 픽셀 URL 생성용 공개 주소
BASE_URL=http://localhost:8006

# --- 발송 파이프라인 ---
MAX_ATTEMPTS=3
RETRY_DELAYS=0,30,300        # 1회차 즉시 · 2회차 30초 · 3회차 5분
WORKER_ENABLED=true          # 재시도 백그라운드 워커
WORKER_INTERVAL=1.0
DISPATCH_ON_REQUEST=true     # 요청 직후 1회차 발송 시도
EVENT_LISTENER_ENABLED=true  # Redis Pub/Sub 구독 리스너

# --- 인증 (공통 계약 §1 · JWT Bearer HS256 · 만료 8h) ---
# PoC 에서는 false — 서비스 간 호출을 토큰 없이 열어 둔다.
# true 로 올리면 /api/v1/notify/** 전체가 Bearer 토큰을 요구한다.
# (/healthz, /metrics, 트래킹 픽셀은 항상 공개)
AUTH_ENABLED=false
JWT_SECRET=poc-dev-secret-change-me

# --- 채널 자격증명 (이 서비스 밖으로 나가지 않음) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=hr-noreply@lge.com
HR_ALERT_EMAIL=hr-team@lge.com
