# DIST_DB 환경변수 예시
SERVICE_PORT=8002

# --- PoC (Docker 없이 로컬 실행) ---
DATABASE_URL=sqlite:///./dist_db.sqlite
REDIS_URL=fakeredis://
USE_MOCK=true
STORAGE_DIR=./storage
LOG_LEVEL=INFO

# USE_MOCK=true 일 때 읽을 실제 취합파일. 파일이 없거나 값을 비우면 합성 데이터로 폴백
MASTER_XLSX=./data/취합파일.xlsx

# 합성 폴백 데이터 생성 시드 (재현성)
MOCK_SEED=20260729

# --- 프로덕션/도커 ---
# DATABASE_URL=postgresql://hruser:hrpass@postgres:5432/dist_db
# REDIS_URL=redis://redis:6379/0
# USE_MOCK=false
# VERSION_MANAGER_URL=http://version-manager:8001
